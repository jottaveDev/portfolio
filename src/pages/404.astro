---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not Found | jvdev">
  <main class="flex items-center justify-center">
    <section class="flex flex-col gap-6">
      <h1 class="text-4xl font-bold">Page Not Found</h1>
      <button class="flex items-center justify-center">
        <a
          href="/"
          class="flex items-center gap-2 font-semibold text-sm py-2 px-4 rounded-md border hover:bg-zinc-200 dark:hover:bg-zinc-700 dark:border-zinc-600 transition-colors duration-300"
          >Voltar para Home <span class="animate-bounce">🏠</span>
        </a>
      </button>
    </section>
  </main>
</Layout>

<style>
  main {
    min-height: calc(100vh - 200px);
  }
</style>
