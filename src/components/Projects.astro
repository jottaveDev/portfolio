---
import { Image } from "astro:assets";
import goLembrarImage from "../assets/golembrar.png";

const projects = [
  {
    href: "golembrar",
    description: "Aplicativo para agendamento e envio de lembretes. ",
    image: goLembrarImage,
    alt: "GoLembrar",
  },
];
---

<section
  id="projects"
  class="flex flex-col items-center gap-4 mt-6 sm:items-start"
>
  <h2 class="font-bold text-2xl self-start sm:self-auto">Projetos</h2>
  <ul class="w-full flex flex-col gap-6 mt-2 sm:flex-row sm:gap-12">
    {
      projects.map((project) => (
        <li class="flex flex-col justify-between gap-3 h-full py-4 px-2 shadow-sm">
          <div class="flex flex-col gap-4">
            <a href={`/projects/${project.href}`}>
              <Image
                src={project.image}
                alt={project.alt}
                class="rounded-md object-cover max-h-[200px] w-full hover:opacity-90 transition-opacity duration-300"
              />
            </a>
            <p>{project.description}</p>
          </div>
          <button
            data-href={`/projects/${project.href}`}
            class="self-start border rounded-md py-1 px-4 hover:bg-zinc-200 dark:hover:bg-zinc-700 dark:border-zinc-600 transition-colors duration-300"
          >
            Saiba mais
          </button>
        </li>
      ))
    }
  </ul>
</section>

<script>
  const button = document.querySelector("button");
  const href = button?.getAttribute("data-href");
  button?.addEventListener("click", () => {
    if (href) {
      window.location.href = href;
    }
  });
</script>
